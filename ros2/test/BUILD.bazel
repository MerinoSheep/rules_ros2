# Regression test for ros2_ament_setup: foxglove_bridge and other consumers
# that look up service schemas via the rosidl_interfaces resource index can
# only find them if .srv (and .action) sources are symlinked into share/<pkg>/
# and listed in the manifest alongside .msg.
ros2_interface_library(
    name = "ament_setup_test_interfaces",
    srcs = [
        "AmentSetupTest.msg",
        "AmentSetupTest.srv",
    ],
)

ros2_ament_setup(
    name = "ament_setup_test_setup",
    testonly = True,
    idl_deps = [":ament_setup_test_interfaces"],
    deps = [],
)

genrule(
    name = "ament_setup_test_manifest",
    testonly = True,
    srcs = [":ament_setup_test_setup"],
    outs = ["ament_setup_test_manifest.actual.txt"],
    cmd = """
        for f in $(execpaths :ament_setup_test_setup); do
            case "$$f" in
                */rosidl_interfaces/ament_setup_test_interfaces)
                    LC_ALL=C sort "$$f" > $@
                    exit 0 ;;
            esac
        done
        echo "rosidl_interfaces manifest not found in ament setup outputs" >&2
        exit 1
    """,
)

write_file(
    name = "ament_setup_test_manifest_golden",
    testonly = True,
    out = "ament_setup_test_manifest.golden.txt",
    content = [
        "msg/AmentSetupTest.msg",
        "srv/AmentSetupTest.srv",
        "",
    ],
    newline = "unix",
)

diff_test(
    name = "ament_setup_test",
    file1 = ":ament_setup_test_manifest",
    file2 = ":ament_setup_test_manifest_golden",
)
